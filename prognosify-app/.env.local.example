# Template. Copy to `.env.local` and fill in your own values.
# `.env.local` is gitignored; this example file is safe to commit.
#
# Supabase dashboard → Project Settings → API

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Never add the service_role key or the database password to any VITE_* variable —
# they are compiled into the browser bundle and would be public.
